# Server configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Optional: Path to Netscape/cookies.txt if deploying on a cloud VPS that hits YouTube bot challenges
# YTDLP_COOKIEFILE=/path/to/cookies.txt

# Optional: HTTP/HTTPS proxy for routing yt-dlp traffic through a residential IP
# PROXY_URL=http://user:password@proxy-host:port
